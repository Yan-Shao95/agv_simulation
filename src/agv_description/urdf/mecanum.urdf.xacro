<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:gz="http://gazebosim.org/schema" name="mecanum_agv">
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><geometry><box size="0.95 0.65 0.22"/></geometry><material name="green"><color rgba="0.1 0.65 0.3 1"/></material></visual>
    <collision><geometry><box size="0.95 0.65 0.22"/></geometry></collision>
    <inertial><mass value="45"/><inertia ixx="2.1" ixy="0" ixz="0" iyy="3.8" iyz="0" izz="5.2"/></inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.21"/></joint>

  <xacro:macro name="mecanum_wheel" params="name x y roller">
    <link name="${name}_wheel">
      <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="dark"><color rgba="0.12 0.12 0.12 1"/></material></visual>
      <collision><geometry><sphere radius="${wheel_radius}"/></geometry></collision>
      <inertial><mass value="1.2"/><inertia ixx="0.007" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.007"/></inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/><origin xyz="${x} ${y} -0.11"/><axis xyz="0 -1 0"/><dynamics damping="0.03"/>
    </joint>
    <gazebo reference="${name}_wheel"><mu1>1.2</mu1><mu2>0.02</mu2><fdir1 gz:expressed_in="base_link">${roller}</fdir1></gazebo>
  </xacro:macro>
  <xacro:mecanum_wheel name="front_left"  x="0.36"  y="0.35"  roller="1 -1 0"/>
  <xacro:mecanum_wheel name="front_right" x="0.36"  y="-0.35" roller="1 1 0"/>
  <xacro:mecanum_wheel name="rear_left"   x="-0.36" y="0.35"  roller="1 1 0"/>
  <xacro:mecanum_wheel name="rear_right"  x="-0.36" y="-0.35" roller="1 -1 0"/>

  <link name="laser_frame"><visual><geometry><cylinder radius="0.06" length="0.05"/></geometry></visual><inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="0 0 0.18"/></joint>
  <link name="imu_link"/><joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/></joint>
  <link name="gps_link"/><joint name="gps_joint" type="fixed"><parent link="base_link"/><child link="gps_link"/><origin xyz="0 0 0.22"/></joint>
  <gazebo reference="laser_frame"><sensor name="lidar" type="gpu_lidar"><topic>scan</topic><update_rate>10</update_rate><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.10</min><max>20.0</max><resolution>0.01</resolution></range></lidar><always_on>true</always_on><visualize>true</visualize></sensor></gazebo>
  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.70</wheel_separation><wheelbase>0.72</wheelbase><wheel_radius>${wheel_radius}</wheel_radius>
      <min_acceleration>-2.0</min_acceleration><max_acceleration>2.0</max_acceleration>
    </plugin>
  </gazebo>
</robot>
